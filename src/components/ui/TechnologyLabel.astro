---
import { technologyIcon } from '../../data/technology-icons';

interface Props { name: string; }
const { name } = Astro.props;
const icon = technologyIcon(name);
---
<span class="technology-label">
  {icon === 'python' ? <img class="technology-icon technology-icon-brand" src={`${import.meta.env.BASE_URL}images/technologies/python.svg`} width="22" height="22" alt="" aria-hidden="true" loading="lazy" decoding="async" /> : icon && <svg class="technology-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {icon === 'monitor' && <><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M6 12h3l2-4 2 8 2-4h3M9 21h6M12 18v3"/></>}
    {icon === 'endpoint' && <><rect x="4" y="3" width="16" height="15" rx="2"/><path d="M8 21h8M12 18v3M8 8h8M8 12h5"/></>}
    {icon === 'network' && <><circle cx="12" cy="5" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="m11 7-5 9m7-9 5 9M7 18h10"/></>}
    {icon === 'system' && <><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M8 6h.01M8 14h8M8 17h5"/></>}
    {icon === 'inspect' && <><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5M7 11h2l1.5-3 2 5 1-2H15"/></>}
    {icon === 'code' && <><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 5l-4 14"/></>}
  </svg>}
  <span>{name}</span>
</span>
