---
import { profile } from '../../data/portfolio';
import Arrow from '../ui/Arrow.astro';
import LabNote from '../ui/LabNote.astro';
---
<section class="hero page-width" aria-labelledby="hero-name">
  <div class="hero-copy">
    <h1 id="hero-name" translate="no">{profile.name}<span aria-hidden="true">.</span></h1>
    <p class="hero-role">{profile.role}</p>
    <p class="hero-headline">{profile.headline}</p>
    <p class="hero-description">{profile.introduction}</p>
    <div class="hero-actions flex flex-wrap items-center gap-6">
      <a class="button-primary" href="#projects">Explore my projects <Arrow direction="down" /></a>
      <a class="text-link" href="#about">A little about me</a>
    </div>
  </div>
  <LabNote />
  <div class="hero-footnote"><span>{profile.focus}</span><span>Learning through labs & research</span></div>
</section>
