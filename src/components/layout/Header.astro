---
import { navigation, profile } from '../../data/portfolio';
const base = import.meta.env.BASE_URL;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header page-width">
  <a class="wordmark" href={base} aria-label={`${profile.name}, home`}>
    <span translate="no">{profile.name}</span>
  </a>
  <nav aria-label="Main navigation">
    <ul class="nav-list">
      {navigation.map(({ label, href }) => <li><a href={`${base}${href}`} aria-current={href === 'about/' && Astro.url.pathname === `${base}about/` ? 'page' : undefined}>{label}</a></li>)}
    </ul>
  </nav>
  <div class="theme-control">
    <label for="theme-select">Theme</label>
    <select id="theme-select" name="theme" aria-label="Color theme">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </div>
</header>
