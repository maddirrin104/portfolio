---
import { navigation, profile } from '../../data/portfolio';
const base = import.meta.env.BASE_URL;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header page-width">
  <a class="wordmark" href={base} aria-label={`${profile.name}, home`}>
    <span class="monogram" aria-hidden="true">{profile.initials}</span>
    <span translate="no">{profile.name}</span>
  </a>
  <nav aria-label="Main navigation">
    <ul class="nav-list">
      {navigation.map(({ label, id }) => <li><a href={`${base}#${id}`}>{label}</a></li>)}
    </ul>
  </nav>
</header>
